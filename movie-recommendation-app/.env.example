# NextAuth Configuration
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# TMDB API Read Access Token (optional; keep this server-side)
TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token_here

# Local Ollama API (the default is http://127.0.0.1:11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b

# App Configuration
NEXT_PUBLIC_APP_NAME=Movie Recommender
NEXT_PUBLIC_APP_DESCRIPTION=Personalized AI-powered movie recommendation system